# MeinImmoKauf – Secrets Template
# 
# WICHTIG: Diese Datei NICHT in Git committen!
# Sie ist bereits in .gitignore enthalten.
#
# Verwendung:
# 1. Kopieren Sie diese Datei zu .streamlit/secrets.toml
# 2. Füllen Sie Ihre SMTP-Credentials aus
# 3. Streamlit lädt automatisch beim Start

# SMTP-Konfiguration für E-Mail-Versand (Passwort-Reset)
# Optional: Wenn nicht konfiguriert, wird E-Mail-Versand deaktiviert
[smtp]
host = "smtp.gmail.com"
port = 587
user = "your-email@gmail.com"
password = "your-app-password"  # Nutzen Sie "App Passwords", nicht echte Passwörter!
from = "noreply@example.com"
use_tls = true

# Optionale Einstellungen
disable_registration = false  # Registrierung erlaubt (true = deaktiviert)

# Weitere optionale Services können hier hinzugefügt werden
# [slack]
# webhook = "https://hooks.slack.com/..."
